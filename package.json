{
  "name": "browser-control",
  "version": "1.2.0",
  "description": "Permission-scoped browser extension, local MCP bridge and portable controller.",
  "type": "module", "license": "MIT", "engines": { "node": ">=22" },
  "bin": { "browser-control": "./scripts/cli.mjs" },
  "scripts": {
    "start": "node scripts/cli.mjs setup", "stop": "node scripts/cli.mjs stop",
    "status": "node scripts/cli.mjs status", "mcp": "node bridge/entry.mjs",
    "check": "node scripts/check.mjs", "test": "node scripts/test.mjs",
    "test:browser": "node scripts/test.mjs --browser",
    "package:source": "node scripts/package.mjs source",
    "package:portable": "node scripts/package.mjs portable",
    "prepare:release": "node scripts/check.mjs && node scripts/audit-release.mjs"
  },
  "dependencies": { "@iarna/toml": "2.2.5", "@modelcontextprotocol/sdk": "1.32.2", "ws": "8.22.1", "zod": "3.25.76" },
  "devDependencies": { "playwright": "1.64.1" }
}
